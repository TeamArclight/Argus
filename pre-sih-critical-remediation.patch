-ARGUS_INTELLIGENCE_EXTRACT_TENDER_URL=http://localhost:8100/extract-tender
-ARGUS_INTELLIGENCE_EXTRACT_DOCUMENT_URL=http://localhost:8100/extract-document
-ARGUS_INTELLIGENCE_RAG_URL=http://localhost:8100/rag-query
+
+# Local-development escape hatch. Honoured ONLY when APP_ENV is development,
+# local or test. Never set this in a hosted environment.
+ARGUS_ALLOW_ANONYMOUS_INTELLIGENCE=false
+
+# REQUIRED for any document_uri the intelligence service resolves from disk.
+# Comma-separated absolute paths; anything outside them is rejected. Without it,
+# local path resolution fails closed.
+ARGUS_ALLOWED_STORAGE_ROOTS=/app/data
+
+# Local-development escape hatch for the allowlist above. Honoured ONLY when
+# APP_ENV is development, local or test.
+ARGUS_ALLOW_UNRESTRICTED_LOCAL_PATHS=false
+
 ARGUS_MODEL_PROVIDER=disabled
 ARGUS_MODEL_NAME=gemini-3.6-flash
 ARGUS_GEMINI_API_KEY=
 ARGUS_RAG_DATABASE_URL=postgresql://argus:argus@postgres:5432/argus
