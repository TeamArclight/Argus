+# ---------------------------------------------------------------------------
 
 # External Intelligence Gateway & Model Configuration
-ARGUS_INTELLIGENCE_BASE_URL=http://localhost:8100
+#
+# In Docker Compose these URLs MUST use the service name, not localhost --
+# inside the api container, localhost is the api container.
+# ---------------------------------------------------------------------------
+ARGUS_INTELLIGENCE_BASE_URL=http://intelligence:8100
+ARGUS_INTELLIGENCE_EXTRACT_TENDER_URL=http://intelligence:8100/extract-tender
+ARGUS_INTELLIGENCE_EXTRACT_DOCUMENT_URL=http://intelligence:8100/extract-document
+ARGUS_INTELLIGENCE_RAG_URL=http://intelligence:8100/rag-query
+
+# REQUIRED. The intelligence service refuses every request without this, unless
+# anonymous access is explicitly enabled below in a local environment. Generate
