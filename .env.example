# ARGUS Application Environment Settings
# APP_ENV drives fail-closed behaviour across all services. Anything other than
# development / local / test is treated as a real environment: the intelligence
# service then refuses to start without a credential, local document resolution
# requires an explicit storage-root allowlist, and development sign-in is off.
APP_ENV=development
DATABASE_URL=postgresql://argus:argus@postgres:5432/argus

# Security & Authentication (ARGUS_JWT_SECRET must be at least 32 characters long)
ARGUS_JWT_SECRET=replace_with_at_least_32_character_strong_secret_key
ARGUS_JWT_ALGORITHM=HS256
ARGUS_JWT_ISSUER=argus-api
ARGUS_JWT_AUDIENCE=argus-clients
ARGUS_JWT_ACCESS_TOKEN_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local Document Storage Configuration
ARGUS_STORAGE_BACKEND=local
ARGUS_STORAGE_LOCAL_PATH=./data/uploads
ARGUS_MAX_UPLOAD_MB=20

# Verification Defaults & Per-Domain Modes (LIVE, PORTAL_CACHED, DOCUMENT, DEMO)
DEFAULT_VERIFICATION_MODE=LIVE
GST_VERIFICATION_MODE=DEMO
UDYAM_VERIFICATION_MODE=DEMO
MCA_VERIFICATION_MODE=DEMO
EPFO_VERIFICATION_MODE=DOCUMENT
ESIC_VERIFICATION_MODE=DOCUMENT
BLACKLIST_VERIFICATION_MODE=DEMO

# Demo Seed Guard (MUST set ALLOW_DEMO_SEED=true alongside a disposable database to allow seed scripts)
ALLOW_DEMO_SEED=false
# ---------------------------------------------------------------------------

# External Intelligence Gateway & Model Configuration
#
# In Docker Compose these URLs MUST use the service name, not localhost --
# inside the api container, localhost is the api container.
# ---------------------------------------------------------------------------
ARGUS_INTELLIGENCE_BASE_URL=http://intelligence:8100
ARGUS_INTELLIGENCE_EXTRACT_TENDER_URL=http://intelligence:8100/extract-tender
ARGUS_INTELLIGENCE_EXTRACT_DOCUMENT_URL=http://intelligence:8100/extract-document
ARGUS_INTELLIGENCE_RAG_URL=http://intelligence:8100/rag-query

# REQUIRED. The intelligence service refuses every request without this, unless
# anonymous access is explicitly enabled below in a local environment. Generate
# with: openssl rand -hex 32
ARGUS_INTELLIGENCE_API_KEY=

# Local-development escape hatch. Honoured ONLY when APP_ENV is development,
# local or test. Never set this in a hosted environment.
ARGUS_ALLOW_ANONYMOUS_INTELLIGENCE=false

# REQUIRED for any document_uri the intelligence service resolves from disk.
# Comma-separated absolute paths; anything outside them is rejected. Without it,
# local path resolution fails closed.
ARGUS_ALLOWED_STORAGE_ROOTS=/app/data

# Local-development escape hatch for the allowlist above. Honoured ONLY when
# APP_ENV is development, local or test.
ARGUS_ALLOW_UNRESTRICTED_LOCAL_PATHS=false

ARGUS_MODEL_PROVIDER=disabled
ARGUS_MODEL_NAME=gemini-3.6-flash
ARGUS_GEMINI_API_KEY=
ARGUS_RAG_DATABASE_URL=postgresql://argus:argus@postgres:5432/argus
# Embedding provider for RAG. 'hash' has no semantic meaning and is for offline
# demos only; set 'gemini' (with ARGUS_GEMINI_API_KEY) for real retrieval.
ARGUS_EMBEDDING_PROVIDER=hash

# Facts extracted below this confidence are reported as low confidence, and the
# deterministic compliance engine will not let them alone produce a PASS.
ARGUS_LOW_CONFIDENCE_THRESHOLD=0.6

# ---------------------------------------------------------------------------

# Frontend Configuration
#
# NEXT_PUBLIC_API_BASE_URL is read by the BROWSER and is inlined into the bundle
# at build time. It must be an origin the visitor's browser can reach: leaving
# it as localhost means every remote user's browser calls their own machine.
# For a hosted deployment, set it to the public API origin and rebuild the web
# image (docker compose build web).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Host interfaces the published ports bind to. Postgres and the intelligence
# service are always loopback-only. Set API_BIND_ADDRESS=127.0.0.1 and front the
# stack with a TLS reverse proxy for any real deployment.
API_BIND_ADDRESS=0.0.0.0
WEB_BIND_ADDRESS=0.0.0.0

# ---------------------------------------------------------------------------
# Local Development Sign-In (/api/auth/dev-token)
#
# CLOSED by default. It requires ARGUS_ENABLE_DEV_AUTH=true, is refused outright
# when APP_ENV or NODE_ENV is production, and has no built-in credentials -- both
# values below must be supplied or the endpoint fails closed. There is no
# default password in the source.
# ---------------------------------------------------------------------------
ARGUS_ENABLE_DEV_AUTH=false
ARGUS_DEV_AUTH_EMAIL=
ARGUS_DEV_AUTH_PASSWORD=

# Comma-separated. Defaults to PROCUREMENT_OFFICER,REVIEWER,AUDITOR when unset.
ARGUS_DEV_AUTH_ALLOWED_ROLES=

# ADMIN is never mintable from the allowlist alone; it needs this separate
# opt-in. Leave false unless an administrator flow is actually being exercised.
ARGUS_DEV_AUTH_ALLOW_ADMIN=false
