# ARGUS Application Environment Settings
APP_ENV=development
DATABASE_URL=postgresql://argus:argus@postgres:5432/argus

# Security & Authentication (ARGUS_JWT_SECRET must be at least 32 characters long)
ARGUS_JWT_SECRET=replace_with_at_least_32_character_strong_secret_key
ARGUS_JWT_ALGORITHM=HS256
ARGUS_JWT_ISSUER=argus-api
ARGUS_JWT_AUDIENCE=argus-clients
ARGUS_JWT_ACCESS_TOKEN_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local Document Storage Configuration
ARGUS_STORAGE_BACKEND=local
ARGUS_STORAGE_LOCAL_PATH=./data/uploads
ARGUS_MAX_UPLOAD_MB=20

# Verification Defaults & Per-Domain Modes (LIVE, PORTAL_CACHED, DOCUMENT, DEMO)
DEFAULT_VERIFICATION_MODE=LIVE
GST_VERIFICATION_MODE=DEMO
UDYAM_VERIFICATION_MODE=DEMO
MCA_VERIFICATION_MODE=DEMO
EPFO_VERIFICATION_MODE=DOCUMENT
ESIC_VERIFICATION_MODE=DOCUMENT
BLACKLIST_VERIFICATION_MODE=DEMO

# Demo Seed Guard (MUST set ALLOW_DEMO_SEED=true alongside a disposable database to allow seed scripts)
ALLOW_DEMO_SEED=false

# External Intelligence Gateway Configuration
ARGUS_INTELLIGENCE_BASE_URL=
ARGUS_INTELLIGENCE_API_KEY=
ARGUS_INTELLIGENCE_EXTRACT_TENDER_URL=
ARGUS_INTELLIGENCE_EXTRACT_DOCUMENT_URL=
ARGUS_INTELLIGENCE_RAG_URL=

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
